# AI provider settings are configured from the frontend's AI Processor
# Settings panel instead — pick a provider (Anthropic, OpenAI, Groq,
# DeepSeek, or a local Ollama instance), paste your own key (not needed
# for Ollama), and choose a model. That key is sent with each scan request
# and is never written to this .env file.

# --- Target Discourse instance ---
# These act as defaults — the dashboard's Discourse Settings panel (globe
# icon in the header) lets each user override the URL, API key, and max
# pages per scan without touching this file.
DISCOURSE_BASE_URL=https://discussions.unity.com

# Generate at {DISCOURSE_BASE_URL}/admin/api/keys. Scope it to the minimum
# needed: topics#latest, topics#show, categories#index, search#query.
# Leave blank to call the API unauthenticated — this works for any public
# category but is rate-limited more aggressively by Discourse and cannot
# see private categories.
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system

# Optional: restrict every scan to one category id (see GET /categories.json,
# or the dropdown in the settings panel). Leave blank for the site-wide feed.
DISCOURSE_CATEGORY_ID=

# --- API client behaviour ---
# Also overridable from the UI's Discourse Settings panel.
DISCOURSE_MAX_PAGES=20
DISCOURSE_REQUEST_DELAY_MS=300
DISCOURSE_MAX_CONCURRENCY=4
DISCOURSE_TIMEOUT_MS=20000

# --- Database ---
DATABASE_PATH=./data/forum_insights.db

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
